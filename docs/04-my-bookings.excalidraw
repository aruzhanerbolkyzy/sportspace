{"type": "excalidraw", "version": 2, "source": "https://excalidraw.com", "elements": [{"id": "e1", "type": "text", "x": 0, "y": -60, "width": 422.24000000000007, "height": 32.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 22974509, "version": 1, "versionNonce": 15293233, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "04 · Мои брони (/my-bookings)", "fontSize": 26, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 26, "containerId": null, "originalText": "04 · Мои брони (/my-bookings)", "lineHeight": 1.25, "autoResize": true}, {"id": "e2", "type": "rectangle", "x": 0, "y": 0, "width": 900, "height": 760, "angle": 0, "strokeColor": "#868e96", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 858303051, "version": 1, "versionNonce": 779933912, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e3", "type": "rectangle", "x": 940, "y": 0, "width": 380, "height": 760, "angle": 0, "strokeColor": "#1d4ed8", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "dashed", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 697582866, "version": 1, "versionNonce": 110350655, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e4", "type": "text", "x": 956, "y": 12, "width": 241.92000000000002, "height": 20.0, "angle": 0, "strokeColor": "#1d4ed8", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 565412095, "version": 1, "versionNonce": 804765446, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Поля из базы на этом экране", "fontSize": 16, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 16, "containerId": null, "originalText": "Поля из базы на этом экране", "lineHeight": 1.25, "autoResize": true}, {"id": "e5", "type": "text", "x": 956, "y": 44, "width": 385.84000000000003, "height": 292.5, "angle": 0, "strokeColor": "#1d4ed8", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 149519331, "version": 1, "versionNonce": 465799331, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "bookings.status — бейдж (4 цвета, см. design.md)\nbookings.start_at, end_at — дата и время\nbookings.total_price — цена (зафиксирована при брони)\nbookings.created_at — «ответ придёт до …»\n  (created_at + 2 часа, БП7)\nvenues.name — название площадки\nbooking_status_history.reason — причина отказа\n  или отмены (показываем у «Отклонена»)\n\nКнопка «Отменить»:\n  активна, если до начала ≥ 2 часов (БП5)\n  неактивна и серая, если меньше 2 часов,\n  под ней ВСЕГДА текст, почему\n  у «Отклонена» и «Отменена» кнопки нет\n  (конечные статусы)\n\nPATCH /bookings/:id/cancel\nСчётчик «Активных броней: 2 из 3» (БП8)", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 13, "containerId": null, "originalText": "bookings.status — бейдж (4 цвета, см. design.md)\nbookings.start_at, end_at — дата и время\nbookings.total_price — цена (зафиксирована при брони)\nbookings.created_at — «ответ придёт до …»\n  (created_at + 2 часа, БП7)\nvenues.name — название площадки\nbooking_status_history.reason — причина отказа\n  или отмены (показываем у «Отклонена»)\n\nКнопка «Отменить»:\n  активна, если до начала ≥ 2 часов (БП5)\n  неактивна и серая, если меньше 2 часов,\n  под ней ВСЕГДА текст, почему\n  у «Отклонена» и «Отменена» кнопки нет\n  (конечные статусы)\n\nPATCH /bookings/:id/cancel\nСчётчик «Активных броней: 2 из 3» (БП8)", "lineHeight": 1.25, "autoResize": true}, {"id": "e6", "type": "rectangle", "x": 0, "y": 0, "width": 900, "height": 50, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e7f0ff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 936026847, "version": 1, "versionNonce": 209170750, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false}, {"id": "e7", "type": "text", "x": 20, "y": 15, "width": 100.80000000000001, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 887077446, "version": 1, "versionNonce": 938350340, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "SportBook", "fontSize": 20, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 20, "containerId": null, "originalText": "SportBook", "lineHeight": 1.25, "autoResize": true}, {"id": "e8", "type": "text", "x": 560, "y": 17, "width": 125.44000000000001, "height": 17.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 226604992, "version": 1, "versionNonce": 30058037, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "Клиент: Айдар Н.", "fontSize": 14, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": nul